{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "files": {
      "additionalProperties": {
        "pattern": "^[0-9a-f]{64}$",
        "type": "string"
      },
      "minProperties": 1,
      "type": "object"
    },
    "releases": {
      "additionalProperties": {
        "additionalProperties": false,
        "properties": {
          "measurements_sha256": {
            "pattern": "^[0-9a-f]{64}$",
            "type": "string"
          },
          "source_revision": {
            "pattern": "^[0-9a-f]{40}$",
            "type": "string"
          }
        },
        "required": [
          "source_revision",
          "measurements_sha256"
        ],
        "type": "object"
      },
      "propertyNames": {
        "pattern": "^v?(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(\\+[0-9A-Za-z.-]+)?$",
        "type": "string"
      },
      "type": "object"
    },
    "repository": {
      "const": "prem-research/podvm"
    },
    "schema_version": {
      "const": 1
    },
    "workloads": {
      "additionalProperties": {
        "items": {
          "pattern": "^v?(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(\\+[0-9A-Za-z.-]+)?$",
          "type": "string"
        },
        "minItems": 1,
        "type": "array",
        "uniqueItems": true
      },
      "propertyNames": {
        "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$",
        "type": "string"
      },
      "type": "object"
    }
  },
  "required": [
    "schema_version",
    "repository",
    "workloads",
    "releases",
    "files"
  ],
  "title": "Frozen PodVM resolution",
  "type": "object"
}
