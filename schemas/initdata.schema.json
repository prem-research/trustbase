{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "algorithm": {
      "enum": [
        "sha256",
        "sha384",
        "sha512"
      ]
    },
    "data": {
      "additionalProperties": {
        "type": "string"
      },
      "properties": {
        "id": {
          "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$",
          "type": "string"
        }
      },
      "required": [
        "id"
      ],
      "type": "object"
    },
    "version": {
      "const": "0.1.0"
    }
  },
  "required": [
    "version",
    "algorithm",
    "data"
  ],
  "title": "Trustbase Init-Data document",
  "type": "object"
}
