{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Attestation policy catalog",
  "type": "object",
  "additionalProperties": false,
  "required": ["policies", "data"],
  "properties": {
    "policies": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1021,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^/(?:[A-Za-z0-9_-][A-Za-z0-9._-]*/)+[A-Za-z0-9_-][A-Za-z0-9._-]*\\.rego$"
      }
    },
    "data": {"type": "array", "maxItems": 0}
  }
}
