{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "candidates": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "path": {
            "pattern": "^([A-Za-z0-9_.-]+/)+[0-9a-f]{64}\\.toml$",
            "type": "string"
          },
          "podvm": {
            "additionalProperties": false,
            "properties": {
              "profile": {
                "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$",
                "type": "string"
              },
              "version": {
                "minLength": 1,
                "type": "string"
              }
            },
            "required": [
              "profile",
              "version"
            ],
            "type": "object"
          },
          "sha256": {
            "pattern": "^[0-9a-f]{64}$",
            "type": "string"
          },
          "workload": {
            "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$",
            "type": "string"
          }
        },
        "required": [
          "workload",
          "path",
          "sha256",
          "podvm"
        ],
        "type": "object"
      },
      "minItems": 1,
      "type": "array"
    },
    "commit": {
      "pattern": "^[0-9a-f]{40}$",
      "type": "string"
    },
    "repository": {
      "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$",
      "type": "string"
    },
    "schema_version": {
      "const": 2
    }
  },
  "required": [
    "schema_version",
    "repository",
    "commit",
    "candidates"
  ],
  "title": "Init-Data candidate dispatch payload",
  "type": "object"
}
